# Copy to .env and fill in.
# Diagnose LLM provider order. OpenAI is tried first, Groq is the fallback.
# Set LLM_PROVIDER=groq to force Groq first (or when only a Groq key is set).
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Voice HITL (Phase 6/8). VOICE_MODE: off | text | voice
VOICE_MODE=off
ELEVENLABS_API_KEY=
# Voice id from your ElevenLabs account (client.voices.get_all()). Default = "Sarah".
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=SENTINEL
DATABASE_URL=sqlite:///data/sentinel.db
